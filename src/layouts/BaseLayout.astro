---
import SplashScreen from "../components/SplashScreen.astro";
import "../styles/global.css";
import NavBarLink from "../components/NavBarLink.astro";
import { Font } from "astro:assets";
import SocialNavLinks from "../components/SocialNavLinks.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "JeremiahJason - Just a guy enjoying life" } =
	Astro.props;
---

<html lang="en" class="font-sans bg-light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<Font cssVariable="--font-helvetica-neue" preload />
		<Font cssVariable="--font-azeret-mono" preload />

		<script
			async
			src="https://plausible.internal.skalatama.com/js/pa-8rjE6EmD_Cm_oksN4XFnJ.js"
		></script>
		<script>
			window.plausible =
				window.plausible ||
				function (...args: unknown[]) {
					(window.plausible.q = window.plausible.q || []).push(args);
				};

			window.plausible.init =
				window.plausible.init ||
				function (options) {
					window.plausible.o = options || {};
				};

			window.plausible.init();
		</script>

		<title>{title}</title>
	</head>
	<body class="relative font-sans">
		<nav
			class="fixed bottom-0 w-full flex justify-center pb-4 md:pb-6 px-4 z-50 pointer-events-none"
			id="navbar"
			data-dark="0"
		>
			<div
				class="w-full md:w-1/6 md:min-w-[550px] h-[70px] md:h-[80px] max-h-max rounded-lg bg-dark/8 shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur-[20px] border border-light/20 px-4 tracking-wider font-light flex flex-col-reverse overflow-hidden pointer-events-auto"
				id="blur-box"
			>
				<div
					class="w-full h-[70px] md:h-[80px] flex items-center justify-between py-4 shrink-0 relative"
				>
					<div class="h-full flex items-center gap-2">
						<button
							class="h-full w-16 md:w-24 font-normal text-sm md:text-lg bg-light rounded cursor-pointer flex items-center justify-center transition-all duration-300 ease-in-out hover:scale-95 hover:bg-accent hover:text-light"
							id="menu-button-text"
						>
							<p class="pt-1">MENU</p>
						</button>
						<button
							class="h-full font-normal text-base md:text-2xl bg-light px-4 rounded cursor-pointer transition-all duration-300 ease-in-out hover:scale-95 hover:bg-accent hover:text-light"
							id="menu-button-plus"
						>
							<p>+</p>
						</button>
					</div>
					<button
						id="contact-button"
						class="h-full w-24 md:w-32 font-normal text-sm md:text-lg bg-highlight rounded cursor-pointer flex items-center justify-center text-light"
					>
						<p class="pt-1">CONTACT</p>
					</button>

					<div
						class="w-full absolute bottom-0 h-[70px] md:h-[80px] flex items-center justify-center pointer-events-none"
					>
						<a
							href="/"
							id="jj-logo"
							class="pointer-events-auto font-mono font-bold tracking-tighter text-xl md:text-3xl transition-[scale] hover:scale-90 duration-300 ease-in-out will-change-transform text-dark/80"
						>
							<span
								>JJ<span
									class="text-highlight text-2xl md:text-4xl -ml-1"
									>.</span
								></span
							>
						</a>
					</div>
				</div>
				<div
					id="nav-link"
					class="w-full grow py-12 md:py-24 flex flex-col gap-6 md:gap-10"
				>
					<NavBarLink link="/">home</NavBarLink>
					<NavBarLink link="#section-work">works</NavBarLink>
					<!-- <NavBarLink link="/">pricing</NavBarLink> -->
					<NavBarLink link="#about-section" offset={-600}>about</NavBarLink
					>
				</div>
				<!-- <span class="text-4xl font-bold">JJ</span> -->
			</div>
		</nav>
		<!-- <SplashScreen /> -->
		<div id="smooth-wrapper">
			<main
				id="smooth-content"
				class="will-change-transform backface-hidden"
			>
				<slot />
				<footer
					class="w-full pt-8 bg-light px-4 md:px-14 pb-24 md:pb-6 flex flex-col-reverse text-dark/80 border-t border-dark/10"
				>
					<div class="flex justify-between w-full">
						<p>© 2026</p>
						<p>JeremiahJason.com</p>
					</div>
					<div class="h-[20px] md:h-[80px]"></div>
					<div class="w-full px-8">
						<SocialNavLinks />
					</div>
				</footer>
			</main>
		</div>
	</body>
</html>

<script>
	import { gsap } from "gsap";

	import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
	import { ScrollSmoother } from "gsap/ScrollSmoother";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrambleTextPlugin);
	gsap.registerPlugin(ScrollSmoother, ScrollTrigger);

	const mm = gsap.matchMedia();

	function initNavbar() {
		const navbar = document.getElementById("navbar");
		const blurBox = document.getElementById("blur-box");
		const menuButtonText = document.getElementById("menu-button-text");
		const menuButtonPlus = document.getElementById("menu-button-plus");

		const contactButton = document.getElementById("contact-button");

		if (
			!blurBox ||
			!menuButtonPlus ||
			!menuButtonText ||
			!contactButton ||
			!navbar
		)
			return;

		// blurBox.classList.add("h-[80px]");
		blurBox.dataset.isOpen = "0";
		gsap.set("#nav-link button", { opacity: 0, y: -20 });

		function animateNavbarContent() {
			if (!blurBox) return;
			const isOpen = blurBox.dataset.isOpen === "1";
			let tl = gsap.timeline();
			if (isOpen) {
				blurBox.dataset.isOpen = "0";
				mm.add(
					{
						isMobile: "(max-width: 767.98px)", // < md
						isTablet: "(min-width: 768px) and (max-width: 1023.98px)", // md → lg
						isDesktop: "(min-width: 1024px)", // lg+
					},
					(context) => {
						const { isMobile, isTablet, isDesktop } =
							context.conditions ?? {};

						tl.to(blurBox, { backdropFilter: "blur(20px)", duration: 1 })
							.to(
								"#nav-link button",
								{ opacity: 0, y: -20, stagger: 0.1 },
								"<"
							)
							.to(
								blurBox,
								{
									height: isMobile ? "70px" : "80px",
									ease: "power3.out",
									duration: 1,
								},
								"<0.3"
							);
					}
				);
			} else {
				blurBox.dataset.isOpen = "1";
				tl.to(blurBox, {
					height: "650px",
					duration: 1.3,
					ease: "power3.out",
				})
					.to(
						blurBox,
						{ backdropFilter: "blur(60px)", duration: 1 },
						"<0.3"
					)
					.to(
						"#nav-link button",
						{ opacity: 1, y: 0, stagger: -0.1 },
						"<"
					);
			}
		}

		function animateMenuButton() {
			if (!blurBox) return;
			const isOpen = blurBox.dataset.isOpen === "1";

			if (isOpen) {
				gsap.to("#menu-button-text p", {
					scrambleText: {
						text: "MENU",
						chars: "upperAndLowerCase",
					},
					duration: 0.5,
				});
				gsap.to("#menu-button-plus p", {
					rotate: 0,
					ease: "power4.inOut",
					duration: 0.5,
				});
			} else {
				gsap.to("#menu-button-text p", {
					scrambleText: {
						text: "CLOSE",
						chars: "upperAndLowerCase",
					},
					duration: 0.5,
				});
				gsap.to("#menu-button-plus p", {
					rotate: 135,
					ease: "power4.inOut",
					duration: 0.5,
				});
			}
		}

		menuButtonText.addEventListener("click", () => {
			animateMenuButton();
			animateNavbarContent();
		});
		menuButtonPlus.addEventListener("click", () => {
			animateMenuButton();
			animateNavbarContent();
		});

		contactButton.addEventListener("mouseenter", () => {
			gsap.to("#contact-button p", {
				// scale: 1,
				scrambleText: {
					text: "CONTACT",
				},
				duration: 0.5,
			});
		});

		contactButton.addEventListener("mouseleave", () => {
			gsap.to("#contact-button p", {
				// scale: 1,
				scrambleText: {
					text: "CONTACT",
				},
				duration: 0.5,
			});
		});

		contactButton.addEventListener("click", async () => {
			gsap.to(window, {
				duration: 1,
				scrollTo: {
					y: "#contact-section",
				},
				ease: "power2.out",
			});
		});

		document.addEventListener("click", (event) => {
			if (blurBox.dataset.isOpen === "0") return;

			const clickedTarget = event.target as HTMLElement;

			const navlinks = document.getElementById("nav-link");

			if (
				!blurBox.contains(clickedTarget) ||
				navlinks?.contains(clickedTarget) ||
				contactButton.contains(clickedTarget)
			) {
				animateMenuButton();
				animateNavbarContent();
			}
		});

		const callback = (mutationsList: any) => {
			for (const mutation of mutationsList) {
				if (
					mutation.type === "attributes" &&
					mutation.attributeName === "data-dark"
				) {
					const isDark = navbar.getAttribute("data-dark") === "1";
					if (isDark) {
						gsap.to("#jj-logo", {
							color: "var(--color-light)",
							duration: 0.5,
						});
						gsap.to("#nav-link button", {
							color: "var(--color-light)",
							duration: 0.5,
						});
					} else {
						gsap.to("#jj-logo", {
							color: "color-mix(in oklab, #0b0b0b 80%, transparent)",
							duration: 0.5,
						});
						gsap.to("#nav-link button", {
							color: "color-mix(in oklab, #0b0b0b 80%, transparent)",
							duration: 0.5,
						});
					}
				}
			}
		};

		// 3. Create the observer instance
		const observer = new MutationObserver(callback);

		// 4. Start observing the target element for attribute changes
		observer.observe(navbar, {
			attributes: true, // Watch for attribute changes
			attributeFilter: ["data-dark"], // Only watch this specific attribute
		});
	}
	initNavbar();

	ScrollSmoother.create({
		smooth: 1,
		normalizeScroll: true,
		effects: true,
	});
</script>
