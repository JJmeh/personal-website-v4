---
import Button from "../components/Button.astro";
import FeaturePieces from "../components/FeaturePieces.astro";
import ScrollDownAnimation from "../components/ScrollDownAnimation.astro";
import WorkCard from "../components/WorkCard.astro";
import { formatEntryDate, getPublishedEntries } from "../data/entries";
import { person, socials } from "../data/site";
import { featuredWorks } from "../data/works";
import BaseLayout from "../layouts/BaseLayout.astro";

/** Home page shows a short teaser; every card comes from the shared sources. */
const featured = featuredWorks.slice(0, 4);
const latestEntries = (await getPublishedEntries()).slice(0, 3);
---

<BaseLayout title="Jeremiah Jason">
	<section
		class="w-full h-(--mobile-hero-feature-section) md:hidden p-1.5 pb-0"
	>
		<FeaturePieces />
	</section>

	<section class="w-full h-80 lg:h-dvh p-1.5 pb-0 min-h-140">
		<div
			class="w-full h-full bg-light flex items-center justify-center rounded-xl relative px-3"
		>
			<div class="flex flex-col gap-1 text-dark">
				<h1
					class="font-bold text-5xl md:text-6xl lg:text-7xl tracking-tight text-dark text-center"
				>
					Jeremiah Jason<span class="text-highlight">.</span>
				</h1>
				<p class="text-center font-medium text-base md:text-lg lg:text-2xl">
					Full-Stack Web Developer
				</p>
			</div>

			<div
				class="w-full bottom-10 left-0 absolute items-center justify-center hidden lg:flex"
			>
				<ScrollDownAnimation />
			</div>
		</div>
	</section>

	<!-- WORKS -->
	<section class="w-full p-1.5 pb-0 flex flex-col gap-1.5">
		<div
			class="w-full h-max bg-light rounded-xl flex items-center justify-center pt-20 pb-12"
		>
			<div class="flex flex-col items-center justify-center">
				<h2
					class="text-6xl lg:text-7xl font-bold tracking-normal lg:tracking-widest"
				>
					WORKS
				</h2>
				<div class="mt-4">
					<Button href="/works" size="lg">VIEW MORE</Button>
				</div>
			</div>
		</div>
		<div
			class="w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 gap-1.5"
		>
			{featured.map((work) => <WorkCard work={work} />)}
			{
				featured.length % 2 !== 0 && (
					<div class="bg-light rounded-xl w-full flex items-center justify-center">
						<Button href="/works" size="lg">
							VIEW MORE
						</Button>
					</div>
				)
			}
		</div>
	</section>

	<!-- PROFILE -->
	<section class="w-full p-1.5 pb-0 flex gap-1.5">
		<div
			class="[writing-mode:vertical-lr] bg-light rounded-xl w-max px-4 md:px-14 py-6 lg:py-10 rotate-180 font-bold text-5xl tracking-widest"
		>
			PROFILE
		</div>
		<div
			class="w-full bg-light rounded-xl px-6 lg:px-12 flex flex-col items-start justify-center gap-2"
		>
			<h2 class="font-bold text-xl">{person.name}</h2>
			<p class="text-lg">
				Born in 2002, lives in {person.location}. I am currently working as
				a full stack developer, while also taking freelancing jobs on the
				side.
			</p>
			<div class="mt-2">
				<Button href="/profile" size="sm">VIEW MORE</Button>
			</div>
		</div>
	</section>

	<!-- ENTRIES -->
	<section class="w-full p-1.5 pb-0">
		<div
			class="bg-light border-light h-max rounded-xl px-4 py-8 md:px-6 lg:p-8 xl:p-10 flex flex-col items-center"
		>
			<h2 class="font-bold tracking-widest text-3xl uppercase text-dark">
				Entries
			</h2>

			{
				latestEntries.length > 0 ? (
					<div class="flex flex-col mt-4 gap-2 w-full">
						{latestEntries.map((entry) => (
							<div class="flex items-center text-dark text-lg gap-2">
								<a
									href={`/entries/${entry.id}/`}
									class="text-accent underline text-lg lg:text-xl shrink-0 max-w-1/2 truncate"
								>
									{entry.data.title}
								</a>
								<div class="h-0.25 border border-accent grow" />
								<p class="shrink-0 text-sm lg:text-base pt-1">
									{formatEntryDate(entry.data.date)}
								</p>
							</div>
						))}
					</div>
				) : (
					<p
						class="text-dark/70 font-medium text-center mt-4"
						role="status"
					>
						Nothing published yet — new entries land here first.
					</p>
				)
			}

			<div class="mt-8">
				<Button href="/entries" size="md">READ MORE</Button>
			</div>
		</div>
	</section>

	<!-- CONTACT -->
	<section class="w-full p-1.5">
		<div
			class="w-full h-max bg-light rounded-xl flex items-center justify-center p-2 lg:p-3 xl:p-4"
		>
			<div
				class="flex flex-col items-center justify-center bg-accent w-full rounded-lg pt-6 pb-8"
			>
				<h2
					class="text-3xl lg:text-4xl font-bold tracking-wider text-white"
				>
					WANT TO TALK?
				</h2>
				<p class="text-base lg:text-lg text-light mt-2">
					Reach me out on my socials
				</p>
				<div
					class="flex flex-row items-center justify-center gap-2 mt-3 flex-wrap px-4"
				>
					{
						socials.map((social) => (
							<Button
								href={social.href}
								variant="chip"
								size="sm"
								target={social.external ? "_blank" : undefined}
							>
								{social.external ? social.label : person.email}
							</Button>
						))
					}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
