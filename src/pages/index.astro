---
import AboutSection from "../components/Home/AboutSection.astro";
import ContactSection from "../components/Home/ContactSection.astro";
import Section2Work from "../components/Section2Work.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Jeremiah Jason">
	<div class="grid grid-cols-1 grid-rows-1 w-screen h-screen relative">
		<section
			id="reveal-hero"
			class="pointer-events-none w-screen h-screen bg-accent items-center justify-center text-dark p-12 col-start-1 col-end-1 row-start-1 row-end-1 z-20
				[clip-path:inset(0_var(--reveal-left)_0px_var(--reveal-right))]
				antialiased
				hidden sm:flex"
		>
			<div
				class="flex items-center justify-center flex-col gap-1 text-center subpixel-antialiased"
			>
				<h1
					class="font-bold text-4xl sm:text-9xl tracking-tight text-light"
				>
					Jeremiah Jason<span class="text-light">.</span>
				</h1>
				<p class="font-normal text-2xl w-full text-light">
					Just a Programmer
				</p>
			</div>
		</section>
		<section
			class="w-screen h-screen bg-light flex items-center justify-center text-dark p-12 col-start-1 col-end-1 row-start-1 row-end-1"
		>
			<div
				class="flex items-center justify-center flex-col gap-0 sm:gap-1 text-center"
			>
				<h1
					class="font-bold text-4xl sm:text-9xl tracking-tight text-black/80"
				>
					Jeremiah Jason<span class="text-accent">.</span>
				</h1>
				<p class="font-normal text-base sm:text-2xl w-full text-black/60">
					Just a Programmer
				</p>
			</div>
		</section>
	</div>

	<div id="outer-container" class="bg-light">
		<div
			class="min-h-screen h-max sm:h-[calc(100vh+4px)] w-full bg-accent antialiased relative overflow-hidden
				-mb-1"
			id="section-work"
		>
			<div class="w-full h-full px-4 sm:px-14 pt-12 pb-28 flex flex-col">
				<div
					id="section-work-header"
					class="mt-4 sm:mt-8 flex items-center justify-between"
				>
					<h2
						class="text-4xl sm:text-6xl font-bold text-light tracking-wide"
					>
						Works
					</h2>
				</div>

				<div id="section-work-content" class="mt-7 flex flex-col h-full">
					<Section2Work
						tags="[ 2025 · WEBSITE · WIX · FRONTEND ]"
						name="ATA Aluminum"
						number={1}
						type="LANDING PAGE"
						desc="Company Profile, a landing page to see all provided service and use case"
						link="https://www.ata-alu.com"
					/>

					<Section2Work
						tags="[ 2026 · WEBSITE · CATALOGUE · FRONTEND ]"
						name="KarlivaHome"
						number={2}
						type="LANDING PAGE & CATALOGUE"
						desc="Company profile landing page catalogue for furniture company manufacture"
						link="https://karlivahome.com/"
					/>

					<Section2Work
						tags="[ 2025 · WEB APP · FULLSTACK ]"
						name="Daoke"
						number={3}
						type="WEB APP"
						desc="Web Application for custom inventory system and business process management"
					/>

					<Section2Work
						tags="[ 2026 · WEBSITE · CATALOGUE · FRONTEND ]"
						name="Purest Coldpress"
						number={4}
						type="LANDING PAGE & CATALOGUE"
						desc="landing page catalogue for juice business"
						link="https://purestcoldpress.com/"
					/>

					<Section2Work
						tags="[ 2025 · WEBSITE · FRONTEND ]"
						name="Skalatama"
						number={5}
						type="PORTFOLIO"
						desc="Portfolio for agency of scaling up consulting business"
						link="https://skalatama.com/"
					/>

					<hr class="border-light/20" />
				</div>
			</div>
		</div>
	</div>

	<AboutSection />

	<ContactSection />
</BaseLayout>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	const mm = gsap.matchMedia();

	let isEnlarge = false;
	let idleTimer: number;
	let isExit = false;

	let lockBlockSizing = false;

	const IDLE_TIME_LIMIT = 1500;

	const block = document.getElementById("reveal-hero");

	const navbar = document.getElementById("navbar");

	gsap.set(block, { xPercent: -50, x: "50vw" });

	function enlargeObject() {
		if (!isEnlarge) {
			gsap.to("html", {
				"--reveal-size": 128,
				"--reveal-shrink": 0,
				duration: 0.4,
				overwrite: "auto",
				ease: "power2.out",
			});
			isEnlarge = true;
		}
	}

	function shrinkObject() {
		if (isEnlarge) {
			gsap.to("html", {
				"--reveal-size": 0,
				"--reveal-shrink": 64,
				duration: 0.4,
				overwrite: true,
				ease: "power2.out",
			});
			isEnlarge = false;
		}
	}

	function resetIdleTimer() {
		enlargeObject();

		clearTimeout(idleTimer);

		idleTimer = setTimeout(() => {
			if (lockBlockSizing) return;
			shrinkObject();
		}, IDLE_TIME_LIMIT);
	}

	let moving: gsap.core.Tween;

	document.addEventListener("mousemove", (e) => {
		if (lockBlockSizing) {
			return;
		}
		resetIdleTimer();
		moving = gsap.to("html", {
			"--reveal-position": `${e.clientX < 128 ? 0 : e.clientX > window.innerWidth - 128 ? window.innerWidth - 128 : e.clientX - 64}px`,
			ease: "power3.out",
			duration: 0.8,
			// overwrite: true,
		});
	});

	document.addEventListener("mouseenter", () => {
		if (lockBlockSizing) return;
		resetIdleTimer();
		isExit = false;
	});

	document.addEventListener("mouseleave", (e) => {
		if (lockBlockSizing) return;
		shrinkObject();
		clearTimeout(idleTimer);
	});

	let switchNavBarMode = false;

	// Second Section (WORK)
	mm.add(
		{
			isMobile: "(max-width: 767.98px)", // < md
			isTablet: "(min-width: 768px) and (max-width: 1023.98px)", // md → lg
			isDesktop: "(min-width: 1024px)", // lg+
			isShort: "(max-height: 699.98px)",
		},
		(context) => {
			const { isMobile, isTablet, isDesktop, isShort } =
				context.conditions ?? {};

			if (isShort) {
				gsap.set("#reveal-hero", { display: "none" });
			}

			if (!isMobile && !isShort) {
				gsap.set("#section-work", {
					clipPath:
						"inset(0px var(--reveal-left) 0px var(--reveal-right))",
				});

				let tl = gsap.timeline({
					scrollTrigger: {
						trigger: "#section-work",
						start: "top bottom-=10px",
						end: "top top",
						scrub: true,
						onUpdate: (self) => {
							gsap.set("html", { "--grow-variable": self.progress });

							if (self.progress > 0.2 && !switchNavBarMode) {
								switchNavBarMode = true;
								if (navbar) {
									navbar.dataset.dark = "1";
								}
							} else if (self.progress <= 0.2 && switchNavBarMode) {
								switchNavBarMode = false;
								if (navbar) {
									navbar.dataset.dark = "0";
								}
							}
						},
						onEnter: () => {
							clearTimeout(idleTimer);
							lockBlockSizing = true;
						},
						onLeaveBack: () => {
							lockBlockSizing = false;
						},
					},
				});

				let tl2 = gsap.timeline({
					scrollTrigger: {
						trigger: "#section-work",
						start: "top+=2px top",
						end: "+=750",
						scrub: true,
						pin: true,
						pinSpacing: true,
						onLeave: () => {
							if (navbar) {
								navbar.dataset.dark = "0";
							}
						},
						onEnterBack: () => {
							if (navbar) {
								navbar.dataset.dark = "1";
							}
						},
					},
				});
			}
		}
	);

	// document.addEventListener("focus", () => {
	// 	if (document.visibilityState === "visible") {
	// 		ScrollTrigger.refresh();
	// 		// tl.invalidate();
	// 	}
	// });

	// // If content height changes async (fonts, images, lazy content), refresh after they resolve
	// document.fonts.ready.then(() => ScrollTrigger.refresh());
</script>
