---

---

<section
	class="bg-light w-screen sm:h-screen px-4 sm:px-14 relative flex flex-col sm:flex-row"
	id="about-section"
>
	<div
		class="h-full shrink-0 w-full sm:w-1/2 flex flex-col sm:pr-8 pt-12 pb-14 sm:pb-28"
		id="about-me-left-side"
	>
		<h2
			class="text-accent font-bold text-4xl sm:text-6xl mt-4 sm:mt-12 text-center"
		>
			About Me
		</h2>
		<div
			class="w-full flex flex-col sm:flex-row mt-6 sm:mt-8 text-accent font-medium text-lg sm:text-xl text-justify gap-4 sm:gap-8"
		>
			<p class="w-full sm:w-1/2">
				Born in 2002, lives in Jakarta, Indonesia. Graduated in 2024 from
				Bina Nusantara University with Computer Science degree, I am
				currently working as a full stack developer in a Software Company,
				while also taking freelancing jobs on the side.
			</p>
			<p class="w-full sm:w-1/2">
				I like space related things like NASA and spaceships. I also love
				programming as it allow me to create anything I want and need
				anytime. As such, I strive to always improve myself until at some
				point my creations is as beautiful, resilient and functional as the
				ships that brings mankind to the moon
			</p>
		</div>
		<div
			class="w-full grow mt-8 rounded-2xl relative bg-dark h-[300px] sm:h-auto"
		>
			<div
				class="absolute top-0 left-0 w-full h-full flex items-center justify-center"
			>
				<div
					class="h-[80%] aspect-square relative bg-dark rounded-full z-20"
				>
					<div
						class="bg-yellow-400 w-[20%] aspect-square rounded-full z-10 absolute left-[calc(50%-10%)] top-[calc(50%-10%)]"
					>
					</div>

					<div
						class="w-[64%] aspect-square rounded-full absolute left-[calc(50%-32%)] top-[calc(50%-32%)] border border-dashed border-light"
					>
					</div>
					<div
						class="w-[64%] aspect-square rounded-full absolute left-[calc(50%-32%)] top-[calc(50%-32%)]"
						id="planet-orbit"
					>
						<div
							class="bg-green-300 rounded-full w-[14%] aspect-square absolute top-[calc(50%-25px)] -left-[7%] z-30"
						>
							<div
								class="w-[250%] aspect-square rounded-full absolute left-[calc(50%-125%)] top-[calc(50%-125%)] border border-dashed border-light"
							>
							</div>
							<div
								class="w-[250%] aspect-square rounded-full absolute left-[calc(50%-125%)] top-[calc(50%-125%)]"
								id="moon-orbit"
							>
								<div
									class="bg-red-300 rounded-full w-[20%] aspect-square absolute top-[calc(50%-10%)] -left-[10%] z-30"
								>
								</div>
							</div>
						</div>
					</div>
				</div>
				{
					Array.from({ length: 50 }, (_, i) => {
						const x = Math.floor(Math.random() * 100) + 1;
						const y = Math.floor(Math.random() * 100) + 1;
						const size = Math.floor(Math.random() * 8) + 1;
						const rotation = Math.floor(Math.random() * 46);
						return (
							<div
								class="w-[5px] bg-light aspect-square left-20 absolute"
								style={{
									top: `${y}%`,
									left: `${x}%`,
									rotate: `${rotation}deg`,
									width: `${size}px`,
								}}
							/>
						);
					})
				}
			</div>
			<div
				class="absolute top-0 left-0 w-full h-full z-50 bg-dark/8 rounded-2xl backdrop-blur-[2px] shadow-[0_4px_30px_rgba(0,0,0,0.1)]"
			>
			</div>
		</div>
	</div>

	<div class="h-[800px] sm:h-full shrink-0 w-full sm:w-1/2 relative">
		<div
			class="absolute w-full h-full left-0 top-0 flex sm:justify-center pl-14 sm:pl-0"
		>
			<div
				class="absolute text-accent text-xl sm:text-4xl font-bold bg-light border-dark/10 px-4 py-2 border w-max pointer-events-auto z-50 rounded top-0 sm:top-20 left-0 sm:left-auto"
				id="experience-title-card"
			>
				<p class="pt-1">Experiences</p>
			</div>
			<div
				class="border-l border-dark/10 h-full relative pointer-events-none"
			>
			</div>

			<div
				id="moving-block-about"
				class="w-3 h-3 bg-accent aspect-square absolute bottom-full hidden sm:block"
			>
			</div>

			<!-- Accurate -->
			<div
				class="experience-card left-card w-3 h-3 aspect-square bg-accent absolute top-[20%] sm:top-[25%] -translate-x-1/2 sm:translate-x-[auto]"
				id="center-box-moving-1"
			>
				<a
					class="absolute left-8 sm:left-auto sm:right-8 -top-12 sm:-top-18 w-max text-accent rounded p-3 sm:p-6 border-2 border-dashed"
					href="#"
				>
					<div class="flex flex-col w-full h-full bg-dark/5 p-2">
						<h3 class="text-lg sm:text-2xl font-medium">
							Accurate Indonesia
						</h3>
						<p class="text-base sm:text-lg text-accent/90">
							Full Stack Developer
						</p>
						<p class="text-xs sm:text-sm mt-1 text-accent/60">
							April 2025 → Today
						</p>
					</div>
				</a>
			</div>

			<!-- Freelance -->
			<div
				class="experience-card right-card w-3 h-3 aspect-square bg-accent absolute top-[40%] -translate-x-1/2 sm:translate-x-[auto]"
				id="center-box-moving-2"
			>
				<a
					class="absolute left-8 -top-12 sm:-top-18 w-max text-accent rounded p-3 sm:p-6 border-2 border-dashed"
					href="#"
				>
					<div class="flex flex-col w-full h-full bg-dark/5 p-2">
						<h3 class="text-lg sm:text-2xl font-medium">Freelance</h3>
						<p class="text-base sm:text-lg text-accent/90">
							Full Stack Developer
						</p>
						<p class="text-xs sm:text-sm mt-1 text-accent/60">
							September 2024 → Today
						</p>
					</div>
				</a>
			</div>

			<!-- Alfagift -->
			<div
				class="experience-card left-card w-3 h-3 aspect-square bg-accent absolute top-[60%] -translate-x-1/2 sm:translate-x-[auto]"
				id="center-box-moving-3"
			>
				<a
					class="absolute left-8 sm:left-auto sm:right-8 -top-12 sm:-top-18 w-max text-accent rounded p-3 sm:p-6 border-2 border-dashed"
					href="#"
				>
					<div class="flex flex-col w-full h-full bg-dark/5 p-2">
						<h3 class="text-lg sm:text-2xl font-medium">
							Global Loyalty Indonesia
						</h3>
						<p class="text-base sm:text-lg text-accent/90">
							Intern Backend Engineer
						</p>
						<p class="text-xs sm:text-sm mt-1 text-accent/60">
							September 2023 → September 2024
						</p>
					</div>
				</a>
			</div>

			<!-- Geniora -->
			<div
				class="experience-card right-card w-3 h-3 aspect-square bg-accent absolute top-[80%] -translate-x-1/2 sm:translate-x-[auto]"
				id="center-box-moving-4"
			>
				<a
					class="absolute left-8 -top-12 sm:-top-18 w-max text-accent rounded p-3 sm:p-6 border-2 border-dashed"
					href="#"
				>
					<div class="flex flex-col w-full h-full bg-dark/5 p-2">
						<h3 class="text-lg sm:text-2xl font-medium">Geniora</h3>
						<p class="text-base sm:text-lg text-accent/90">
							Part-time Web Developer
						</p>
						<p class="text-xs sm:text-sm mt-1 text-accent/60">
							September 2021 → September 2023
						</p>
					</div>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const mm = gsap.matchMedia();

	mm.add(
		{
			isMobile: "(max-width: 767.98px)", // < md
			isTablet: "(min-width: 768px) and (max-width: 1023.98px)", // md → lg
			isDesktop: "(min-width: 1024px)", // lg+
			isShort: "(max-height: 699.98px)",
		},
		(context) => {
			const { isMobile, isTablet, isDesktop, isShort } =
				context.conditions ?? {};
			if (!isMobile && !isShort) {
				gsap.set("#about-me-left-side", {
					clipPath: "inset(0px 0px 100% 0px)",
				});
				gsap.set(".experience-card", { top: "-5%" });

				gsap.set(".experience-card.left-card a", {
					clipPath: "inset(0% 0% 0px 100%)",
				});
				gsap.set(".experience-card.right-card a", {
					clipPath: "inset(0% 100% 0px 0%)",
				});

				gsap.set("#experience-title-card", {
					clipPath: "inset(0px 0px 100% 0px)",
				});

				let tl = gsap.timeline({
					scrollTrigger: {
						trigger: "#about-section",
						start: "top bottom-=50%",
						end: "top top",
						scrub: true,
						onUpdate: (self) => {},
					},
				});

				tl.to("#about-me-left-side", {
					clipPath: "inset(0px 0px 0% 0px)",
					ease: "power2.inOut",
				})
					.to("#moving-block-about", { bottom: "0%" }, "<")
					.to("#center-box-moving-1", { top: "25%" }, "<")
					.to("#center-box-moving-2", { top: "40%" }, "<")
					.to("#center-box-moving-3", { top: "60%" }, "<")
					.to("#center-box-moving-4", { top: "80%" }, "<")
					.to(
						"#experience-title-card",
						{ clipPath: "inset(0px 0px 0% 0px)", duration: 0.3 },
						"<+=0.1"
					);

				let tl2 = gsap.timeline({
					scrollTrigger: {
						trigger: "#about-section",
						start: "top+=0px top",
						end: "+=1000",
						scrub: true,
						pin: true,
						pinSpacing: true,
						onLeave: () => {
							console.log("leave hide square");
							gsap.set("#moving-block-about", { opacity: 0 });
						},
						onEnterBack: () => {
							console.log("Show square");
							gsap.set("#moving-block-about", { opacity: 1 });
						},
					},
				});

				const tl3 = gsap.timeline({
					scrollTrigger: {
						trigger: "#about-section",
						start: "top+=80% 80%",
						end: "bottom top+=50%",
						scrub: true,
					},
				});

				tl3.to(".experience-card.left-card a", {
					clipPath: "inset(0% 0% 0px 0%)",
					stagger: 0.2,
					duration: 1,
				}).to(
					".experience-card.right-card a",
					{
						clipPath: "inset(0% 0% 0px 0%)",
						stagger: 0.2,
						duration: 1,
						delay: 0.1,
					},
					"<"
				);
			}
		}
	);

	function initSolarSystem() {
		gsap.to("#planet-orbit", {
			rotate: "360",
			repeat: -1,
			ease: "none",
			duration: 15,
		});

		gsap.to("#moon-orbit", {
			rotate: "-360",
			repeat: -1,
			ease: "none",
			duration: 10,
		});
	}
	initSolarSystem();
</script>
