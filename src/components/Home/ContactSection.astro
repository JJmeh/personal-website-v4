---
import SocialNavLinks from "../SocialNavLinks.astro";
---

<section
	class="bg-light w-screen h-screen px-4 sm:px-14 relative flex items-center justify-center border-t sm:border-t-0 border-dark/10"
	id="contact-section"
>
	<!-- <div class="w-1/2 bg-red-400 mt-[10%] h-1/2 z-20" id="contact-box"></div> -->
	<div
		class="absolute top-0 left-0 w-full h-full flex justify-center items-end px-4 sm:px-14"
	>
		<div class="h-full w-full flex flex-col items-center relative">
			<div
				id="moving-block-contact"
				class="moving-block-contact rounded w-full sm:w-2/3 h-2/3 sm:h-1/4 bg-accent aspect-square absolute bottom-[50%] sm:bottom-[40%] left-2/4 -translate-x-1/2 z-40 translate-y-1/2 p-8 flex flex-col items-center justify-center gap-4 text-center"
			>
				<h2
					id="contact-block-content"
					class="text-light text-4xl sm:text-6xl font-bold"
				>
					Want to Talk?
				</h2>
				<p
					id="contact-block-content"
					class="text-lg sm:text-3xl text-light"
				>
					Reach me out here on my socials
				</p>
				<div id="contact-block-content" class="mt-6 sm:mt-4">
					<SocialNavLinks mode1 />
				</div>
			</div>
			<div
				class="moving-block-contact w-3 h-3 bg-accent aspect-square absolute bottom-full left-3/4 -translate-x-1/2 z-30 translate-y-1/2 hidden sm:block"
				id="the-square-one"
			>
			</div>
			<div
				class="bg-dark/10 w-1/4 h-1/4 translate-x-1/2 [clip-path:polygon(100%_0,100%_1px,1px_100%,0_100%)]"
			>
			</div>
			<div
				class="border-l border-dark/10 h-full sm:h-3/4 relative pointer-events-none"
			>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const mm = gsap.matchMedia();

	mm.add(
		{
			isMobile: "(max-width: 767.98px)", // < md
			isTablet: "(min-width: 768px) and (max-width: 1023.98px)", // md → lg
			isDesktop: "(min-width: 1024px)", // lg+
			isShort: "(max-height: 699.98px)",
		},
		(context) => {
			const { isMobile, isTablet, isDesktop, isShort } =
				context.conditions ?? {};
			if (!isMobile && !isShort) {
				gsap.set("#moving-block-contact", {
					clipPath: "inset(50%)",
					bottom: "100%",
					left: "75%",
				});

				gsap.set("#contact-block-content", { opacity: 0 });
				let tl = gsap.timeline({
					scrollTrigger: {
						trigger: "#contact-section",
						start: "top bottom-=40%",
						end: "top top",
						scrub: true,
						onUpdate: (self) => {},
					},
				});

				tl.to(".moving-block-contact", {
					left: "50%",
					bottom: "75%",
					duration: 3,
				})
					.to(".moving-block-contact#moving-block-contact", {
						y: "47vh",
						duration: 2,
					})
					.to(
						".moving-block-contact#the-square-one",
						{ y: "35vh", duration: 2 },
						"<"
					)
					.to(".moving-block-contact#moving-block-contact", {
						clipPath: "inset(0%)",
						duration: 3,
					})
					.to(
						"#contact-block-content",
						{ opacity: 1, stagger: 0.2 },
						"-=1.5"
					);
			}
		}
	);
</script>
