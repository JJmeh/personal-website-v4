---
/**
 * The single-title hero used by /works, /entries, /profile and /404.
 */
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="w-full h-[70dvh] min-h-[400px] p-1.5 pb-0">
	<div
		class="w-full h-full bg-light flex items-center justify-center rounded-xl relative px-3"
	>
		<div class="flex flex-col items-center gap-2 text-dark">
			<h1
				class="font-bold text-5xl md:text-6xl lg:text-7xl tracking-wider text-dark text-center"
			>
				{title}<slot name="title-suffix" />
			</h1>
			{subtitle && (
				<p class="text-center text-base md:text-lg text-dark/70 font-medium">
					{subtitle}
				</p>
			)}
			<slot />
		</div>
	</div>
</section>
