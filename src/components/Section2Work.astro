---
interface Props {
	tags: string;
	name: string;
	number: number;
	type: string;
	desc: string;
	link?: string;
}

const { tags, name, type, desc, link, number } = Astro.props;
---

<a
	class="w-full h-[220px] min-h-max sm:h-1/5 flex text-light items-center sm:justify-between relative"
	href={link ? link : "#"}
	target="_blank"
	id="section-2-work"
	data-number={number}
>
	<hr class="border-light/20 box-border top-0 absolute w-full left-0" />

	<hr
		class="w-2/3 absolute top-0 left-0 [clip-path:inset(0px_0px_0px_100%)]"
		id="work-left-hr"
	/>
	<hr
		class="w-2/3 absolute bottom-0 left-0 [clip-path:inset(0px_0px_0px_100%)]"
		id="work-left-hr"
	/>

	<hr
		class="w-1/3 absolute top-0 right-0 [clip-path:inset(0px_100%_0px_0px)]"
		id="work-right-hr"
	/>
	<hr
		class="w-1/3 absolute bottom-0 right-0 [clip-path:inset(0px_100%_0px_0px)]"
		id="work-right-hr"
	/>

	<div
		class="items-center justify-between w-1/12 overflow-hidden sm:w-2/3 pr-12 flex invisible sm:visible"
	>
		<p class="text-xs leading-6" id="work-tags">{tags}</p>
		<h3 class="text-2xl sm:text-5xl font-semibold text-light">{name}</h3>
	</div>

	<div class="border-l border-light/20 h-full relative sm:pl-0">
		<div
			class="z-10 absolute top-[10%] sm:top-[calc(50%-16px)] -left-4 sm:-left-5 w-8 sm:w-10 h-6 sm:h-8 text-light font-bold bg-accent border-light/20 border text-xs sm:text-sm font-mono text-center py-1 flex items-center justify-center"
		>
			<div
				class="w-[calc(100%+1px)] h-full bg-light absolute flex items-center justify-center text-accent top-0 -left-px z-30 [clip-path:inset(0px_0px_100%_0px)]"
				id="work-number-bg"
			>
				<span class="z-20"> 0{number} </span>
			</div>
			<span class="z-20 opacity-70" id="work-center-box-behind-text">
				0{number}
			</span>
		</div>
		<div
			class="border-l border-light absolute left-0 top-0 h-[10%] sm:h-1/2 [clip-path:inset(100%_0px_0px_0px)]"
			id="work-card-vertical-line-top"
		>
		</div>
		<div
			class="border-l border-light absolute left-0 bottom-0 h-[90%] sm:h-1/2 [clip-path:inset(0px_0px_100%_0px)]"
			id="work-card-vertical-line-bottom"
		>
		</div>
	</div>

	<div
		class="flex items-start sm:items-center justify-between w-11/12 sm:w-1/3 pl-12 h-full sm:h-auto pt-7 sm:pt-0 pb-4 sm:pb-0"
	>
		<div class="flex flex-col text-sm pr-4 h-full">
			<h3
				class="text-2xl sm:text-5xl font-semibold text-light block sm:hidden mb-1"
			>
				{name}
			</h3>
			<p
				class="font-medium text-light opacity-80 text-xs sm:text-base"
				id="work-type"
			>
				{type}
			</p>
			<p
				id="work-desc"
				class="sm:h-14 sm:max-h-max overflow-hidden text-light"
			>
				<span class="block pt-2">
					{desc}
				</span>
			</p>
			<p class="text-xs leading-6 sm:hidden mt-4 w-3/5" id="work-tags">
				{tags}
			</p>
		</div>

		<svg
			class={`sm:w-6 sm:h-6 text-light ${link ? "" : "hidden"} shrink-0`}
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			fill="none"
			viewBox="0 0 24 24"
		>
			<path
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M18 14v4.833A1.166 1.166 0 0 1 16.833 20H5.167A1.167 1.167 0 0 1 4 18.833V7.167A1.166 1.166 0 0 1 5.167 6h4.618m4.447-2H20v5.768m-7.889 2.121 7.778-7.778"
			></path>
		</svg>
	</div>

	<script>
		import { gsap } from "gsap";
		import { Flip } from "gsap/Flip";

		gsap.registerPlugin(Flip);

		const mm = gsap.matchMedia();

		function initWorkSectionCard() {
			const section2works = document.querySelectorAll("#section-2-work");
			if (!section2works) return;

			mm.add(
				{
					isMobile: "(max-width: 767.98px)", // < md
					isTablet: "(min-width: 768px) and (max-width: 1023.98px)", // md → lg
					isDesktop: "(min-width: 1024px)", // lg+
				},
				(context) => {
					const { isMobile, isTablet, isDesktop } =
						context.conditions ?? {};

					section2works.forEach((el) => {
						let tagsText = "";

						if (!isMobile) {
							gsap.context(() => {
								gsap.set("#work-desc", {
									height: "0px",
								});
								gsap.set("h3", {
									opacity: 0.5,
								});
								gsap.set("#work-type", { opacity: 0.4 });
								const tags = el.querySelector("#work-tags");
								if (tags) {
									tagsText = tags.innerHTML;
									tags.innerHTML = "";
								}
								gsap.set("#work-center-box-behind-text", {
									opacity: 0.2,
								});
								gsap.set("svg", {
									opacity: 0,
								});
							}, el);
						}
						el.addEventListener("mouseenter", () => {
							gsap.context(() => {
								gsap.to("#work-left-hr", {
									clipPath: "inset(0px 0px 0px 0%)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-right-hr", {
									clipPath: "inset(0px 0% 0px 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-card-vertical-line-top", {
									clipPath: "inset(0% 0px 0px 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-card-vertical-line-bottom", {
									clipPath: "inset(0px 0px 0% 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-number-bg", {
									clipPath: "inset(0px 0px 0% 0px)",
									ease: "power3.out",
									duration: 0.5,
								});

								if (!isMobile) {
									gsap.to("#work-desc", {
										height: "56px",
										ease: "power3.out",
										duration: 0.7,
									});

									gsap.to("h3", {
										opacity: 1,
										ease: "power3.out",
										duration: 0.5,
									});
									gsap.to("#work-tags", {
										scrambleText: tagsText,
										ease: "power3.out",
										duration: 0.7,
									});

									gsap.to("svg", {
										opacity: 1,
										ease: "power3.out",
										duration: 0.5,
									});

									gsap.to("#work-type", {
										opacity: 0.8,
										ease: "power3.out",
										duration: 0.7,
									});
								}
							}, el);
						});

						el.addEventListener("mouseleave", () => {
							gsap.context(() => {
								gsap.to("#work-left-hr", {
									clipPath: "inset(0px 0px 0px 100%)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-right-hr", {
									clipPath: "inset(0px 100% 0px 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-card-vertical-line-top", {
									clipPath: "inset(100% 0px 0px 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								gsap.to("#work-card-vertical-line-bottom", {
									clipPath: "inset(0px 0px 100% 0px)",
									ease: "power3.out",
									duration: 0.7,
								});

								if (!isMobile) {
									gsap.to("#work-number-bg", {
										clipPath: "inset(0px 0px 100% 0px)",
										ease: "power3.out",
										duration: 0.5,
									});

									gsap.to("#work-desc", {
										height: "0px",
										ease: "power3.out",
										duration: 0.7,
									});

									gsap.to("h3", {
										opacity: 0.5,
										ease: "power3.out",
										duration: 0.5,
									});

									gsap.to("#work-tags", {
										scrambleText: "",
										ease: "power3.out",
										duration: 0.7,
									});

									gsap.to("svg", {
										opacity: 0,
										ease: "power3.out",
										duration: 0.5,
									});

									gsap.to("#work-type", {
										opacity: 0.4,
										ease: "power3.out",
										duration: 0.7,
									});
								}
							}, el);
						});
					});
				}
			);
		}

		initWorkSectionCard();
	</script>
</a>
