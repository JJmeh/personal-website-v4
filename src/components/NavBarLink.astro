---
interface Props {
	link: string;
	offset?: number;
}

const { link, offset } = Astro.props;
---

<button
	data-link={link}
	data-offset={offset}
	id="nav-link-a"
	class="text-center font-semibold tracking-tight text-4xl md:text-6xl text-dark/80 w-full will-change-transform antialiased cursor-pointer"
	><slot /></button
>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { navigate } from "astro:transitions/client";

	gsap.registerPlugin(ScrollToPlugin);

	const navLinks = document.querySelectorAll("#nav-link-a");

	navLinks.forEach((el) => {
		const text = el.textContent;
		const link = (el as HTMLElement).dataset.link;
		const offset = Number((el as HTMLElement).dataset.offset);
		console.log(offset);
		el.addEventListener("click", async () => {
			console.log(link);
			if (link) {
				if (link.includes("#")) {
					console.log("SCROLL");
					gsap.to(window, {
						duration: 1,
						scrollTo: {
							y: link,
							offsetY: offset ? offset : 0,
						},
						ease: "power2.out",
					});
				} else {
					await navigate(link);
				}
			}
		});

		el.addEventListener("mouseover", () => {
			gsap.to(el, {
				// scale: 0.9,
				duration: 0.5,
				scrambleText: {
					text: text,
					chars: "lowerCase",
				},
			});
		});
		el.addEventListener("mouseout", () => {
			gsap.to(el, {
				// scale: 1,
				scrambleText: {
					text: text,
					chars: "lowerCase",
				},
				duration: 0.5,
			});
		});
	});
</script>
