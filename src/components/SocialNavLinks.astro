---
interface Props {
	mode1?: boolean;
}

const { mode1 } = Astro.props;
---

<div
	class="w-full flex items-center justify-center gap-2 sm:gap-4 flex-wrap text-sm sm:text-base"
	id="footer-nav-link-social"
>
	<button
		class={`px-2 pb-1 pt-2 rounded ${mode1 ? "bg-light/90 text-accent" : "bg-dark/5 text-highlight"}  cursor-pointer`}
		>jeremiah.kaliki@gmail.com</button
	>
	<a
		href="https://www.instagram.com/jj.klki_/"
		target="_blank"
		class={`px-2 pb-1 pt-2 rounded ${mode1 ? "bg-light/90" : "bg-dark/5"}`}
		>INSTAGRAM</a
	>
	<a
		href="https://www.linkedin.com/in/jeremiahjason/"
		target="_blank"
		class={`px-2 pb-1 pt-2 rounded ${mode1 ? "bg-light/90" : "bg-dark/5"}`}
		>LINKEDIN</a
	>
	<a
		href="https://github.com/JJmeh"
		target="_blank"
		class={`px-2 pb-1 pt-2 rounded ${mode1 ? "bg-light/90" : "bg-dark/5"}`}
		>GITHUB</a
	>
</div>

<script>
	import { gsap } from "gsap";

	import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

	gsap.registerPlugin(ScrambleTextPlugin);

	function initFooter() {
		let lockEmailButtonScramble = false;
		const footerNavLink = document.getElementById("footer-nav-link-social");

		if (!footerNavLink) return;
		const emailButton = footerNavLink.querySelector("button");
		const socialLinks = footerNavLink.querySelectorAll("a");

		if (!emailButton || !socialLinks) return;

		emailButton.addEventListener("mouseenter", () => {
			if (lockEmailButtonScramble) return;
			gsap.to(emailButton, {
				scrambleText: "Click to copy.",
			});
		});
		emailButton.addEventListener("mouseleave", () => {
			if (lockEmailButtonScramble) return;
			gsap.to(emailButton, {
				scrambleText: "jeremiah.kaliki@gmail.com",
			});
		});
		emailButton.addEventListener("click", () => {
			if (lockEmailButtonScramble) return;
			navigator.clipboard.writeText("jeremiah.kaliki@gmail.com").then(() => {
				gsap.to(emailButton, {
					scrambleText: "Copied to clipboard.",
				});
				lockEmailButtonScramble = true;
				setTimeout(() => {
					gsap.to(emailButton, {
						scrambleText: "jeremiah.kaliki@gmail.com",
					});
					lockEmailButtonScramble = false;
				}, 3000);
			});
		});

		socialLinks.forEach((el) => {
			const text = el.innerText;
			el.addEventListener("mouseenter", () => {
				gsap.to(el, { scrambleText: text });
			});

			el.addEventListener("mouseleave", () => {
				gsap.to(el, { scrambleText: text });
			});
		});
	}
	initFooter();
</script>
