---
interface Props {
	link: string;
}

const { link } = Astro.props;
---

<a
	href={link}
	class="pointer-events-auto transform-gpu backface-hidden font-semibold tracking-widest text-[10px] lg:text-xs bg-accent text-light px-3.5 pb-1.5 pt-2.5 rounded-full h-max hover:scale-90 will-change-transform transition-all duration-300 ease-in-out"
>
	<slot />
</a>
